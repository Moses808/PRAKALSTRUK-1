def piramida_angka(angka):
    for i in range(1, angka + 1):
        
        spasi= " " * (angka - i)
        
        naik= []
        for j in range(1, i + 1):
            naik.append(str(j))
            
        turun= []
        for j in range(i - 1, 0, -1):
            turun.append(str(j))
            
        baris= naik
        
        print(spasi + " ".join(baris))
        
#input
angka= int(input("masukkan angka:"))

piramida_angka(angka)